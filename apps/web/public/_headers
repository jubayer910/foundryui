# Cloudflare static-asset headers (Workers assets read this file at deploy).
# Code files and shadcn registry JSON are for tools and copy buttons, not search results:
# keep them out of Google's index without blocking the fetch.
/c/*
  X-Robots-Tag: noindex
/r/*
  X-Robots-Tag: noindex
# Hashed build files never change under the same name: cache them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
