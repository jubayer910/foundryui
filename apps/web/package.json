{
  "name": "foundry-ui-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/templates-export.mjs && node scripts/library-finalize.mjs && node scripts/code-gate.mjs && node scripts/og-visuals.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/assets-ignore.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "registry": "node scripts/build-registry.mts",
    "db:migrate:local": "wrangler d1 migrations apply foundry-ui-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply foundry-ui-db --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "html-to-image": "^1.11.13",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  }
}
